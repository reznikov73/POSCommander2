{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "mingw-release",
      "displayName": "MinGW-w64 GCC (Release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_RC_COMPILER": "windres"
      },
      "environment": { "PATH": "C:/Tools/w64devkit/bin;$penv{PATH}" }
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC (Release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    { "name": "mingw-release", "configurePreset": "mingw-release", "environment": { "PATH": "C:/Tools/w64devkit/bin;$penv{PATH}" } },
    { "name": "msvc-release", "configurePreset": "msvc-release" }
  ]
}
