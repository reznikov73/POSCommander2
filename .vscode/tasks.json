{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "configure (mingw)",
      "type": "shell",
      "command": "cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_COMPILER=g++ -DCMAKE_RC_COMPILER=windres",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "build",
      "type": "shell",
      "command": "cmake --build build",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "run",
      "type": "shell",
      "command": "cmake --build build; if ($LASTEXITCODE -eq 0) { Start-Process .\\build\\POSCommander2.exe }",
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "build",
      "problemMatcher": []
    },
    {
      "label": "selftest",
      "type": "shell",
      "command": ".\\build\\POSCommander2.exe --selftest; Get-Content $env:TEMP\\posc2-selftest.txt",
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "build",
      "problemMatcher": []
    }
  ]
}
