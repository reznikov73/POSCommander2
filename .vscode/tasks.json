{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Настроить CMake",
      "type": "shell",
      "command": "\"C:/Tools/w64devkit/bin/cmake.exe\" --preset mingw-release",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Собрать",
      "type": "shell",
      "command": "\"C:/Tools/w64devkit/bin/cmake.exe\" --build --preset mingw-release",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "dependsOn": [
        "Настроить CMake"
      ]
    },
    {
      "label": "Пересобрать (очистить)",
      "type": "shell",
      "command": "\"C:/Tools/w64devkit/bin/cmake.exe\" --build --preset mingw-release --clean-first",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ],
      "dependsOn": [
        "Настроить CMake"
      ]
    },
    {
      "label": "Запустить",
      "type": "shell",
      "command": "Start-Process \"${workspaceFolder}\\build\\PosFiles.exe\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "dependsOn": [
        "Собрать"
      ]
    },
    {
      "label": "Самопроверка",
      "type": "shell",
      "command": "$p = Start-Process \"${workspaceFolder}\\build\\PosFiles.exe\" -ArgumentList '--selftest' -Wait -PassThru; Write-Host \"exit=$($p.ExitCode)\"; if (Test-Path \"$env:TEMP\\posfiles-selftest.txt\") { Get-Content \"$env:TEMP\\posfiles-selftest.txt\" }",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "dependsOn": [
        "Собрать"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    }
  ]
}
